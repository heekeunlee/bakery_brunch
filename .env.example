# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 커밋되지 않습니다.

# 카카오맵 JavaScript 앱 키 — 브라우저에 노출되는 것이 정상입니다.
# 반드시 카카오 디벨로퍼스에서 "플랫폼 > Web" 도메인 제한을 걸어두세요.
VITE_KAKAO_JS_KEY=

# 아래 두 개는 수집 스크립트 전용입니다. 절대 프런트엔드로 넘기지 마세요.
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_KEY=

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
